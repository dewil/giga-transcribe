#!/bin/zsh
# Обертка transcribe-meeting под macOS Quick Action (Finder).
# Quick Action стартует с урезанным PATH - добавляем Homebrew (для ffmpeg) и ~/.local/bin.
# Фидбэк - через ДИАЛОГИ (баннеры-уведомления osascript часто подавлены на машине, а диалоги
# показываются всегда): стартовый диалог показывает файл и спрашивает число участников,
# финальный (авто-закрытие) сообщает результат. Прогресс "0%" в шестеренке Automator - его UI,
# не наш; имя файла туда не пробросить.
BREW_BIN=""
command -v brew >/dev/null 2>&1 && BREW_BIN="$(brew --prefix)/bin"
export PATH="${BREW_BIN}:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

LOG="/tmp/transcribe-quickaction.log"; : > "$LOG"

# авто-закрывающийся диалог, в фоне (не блокирует обработку)
show() { osascript -e "display dialog \"$1\" with title \"Транскрибировать (GigaAM)\" buttons {\"OK\"} default button 1 giving up after 6" >/dev/null 2>&1 & }

# стартовый диалог: показывает файл(ы) и спрашивает число участников.
# Enter/пусто = авто; число = --speakers N; Отмена = выход.
if (( $# == 1 )); then finfo="${1:t}"; else finfo="$# файлов"; fi
ans=$(osascript -e "display dialog \"Файл: $finfo

Сколько участников на записи?  (Enter - авто-определение)\" default answer \"\" with title \"Транскрибировать (GigaAM)\" buttons {\"Отмена\",\"OK\"} default button \"OK\"" -e 'text returned of result' 2>/dev/null) || exit 0
SPK=()
if [[ -n "$ans" && "$ans" == <-> ]] && (( ans > 0 )); then
  SPK=(--speakers "$ans")
fi

tmpout=""
trap '[ -n "$tmpout" ] && rm -f "$tmpout" 2>/dev/null' EXIT INT TERM

for f in "$@"; do
  b="${f:t}"
  tmpout=$(mktemp)
  transcribe-meeting "${SPK[@]}" "$f" >"$tmpout" 2>>"$LOG"
  rc=$?
  out=$(cat "$tmpout"); rm -f "$tmpout"; tmpout=""
  if [ $rc -eq 0 ] && [ -n "$out" ]; then
    open -R "$out" >/dev/null 2>&1        # показать md в Finder
    show "✅ Готово: ${out:t}"
  else
    show "❌ Ошибка: $b
лог: $LOG"
  fi
done
